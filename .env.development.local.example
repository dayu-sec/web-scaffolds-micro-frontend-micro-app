# 单独启动微应用

# 请基于该模板文件创建 `.env.development.local` 并配置 API 代理环境

# ⚠️ 仓库中不要提交真实 API 地址、Token、证书或私有代理配置

# 微应用单独启动时使用的 Vite 开发服务端口。
DEV_SERVER_PORT=5173

# 微应用单独开发时使用的 API 代理上游；浏览器请求统一使用 /dysec/api/...
# 留空时不启用远端代理，仅使用本地 Mock；DEV_ 变量不会暴露到 import.meta.env。
DEV_API_URL=

# 可选，仅本地开发接口调用使用的 Bearer Token。
DEV_API_TOKEN=
