    "@antv/g6-extension-react": "^0.2.7",
    "@antv/x6": "^3.1.7",
    "@codemirror/lang-json": "^6.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dayu-sec/bizcom-theme": "1.0.0",
    "@dayu-sec/bizlib-request": "1.0.0",
    "@dayu-sec/bizlib-shared-types": "1.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@react-querybuilder/antd": "^8.17.0",
    "@react-querybuilder/dnd": "^8.17.0",
    "@seed-fe/batch-request": "^1.0.0",
    "@seed-fe/logger": "^1.1.0",
    "@seed-fe/react-permission": "2.0.0-alpha.1",
    "@seed-fe/slashify": "1.0.0-alpha.0",
    "@tanstack/react-query": "^5.101.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "ahooks": "^3.9.7",
    "antd": "6.4.3",
    "axios": "^1.17.0",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.8",
    "echarts": "^6.1.0",
    "echarts-for-react": "3.0.6",
    "filesize": "^11.0.17",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.1",
    "i18next-http-backend": "^4.0.0",
    "immer": "^11.1.8",
    "katex": "^0.17.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.55.1",
    "re-resizable": "^6.11.2",
    "react": "^19.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-querybuilder": "^8.17.0",
    "react-resizable": "^4.0.1",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "code-inspector-plugin": "^1.5.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.7",
    "mockjs": "^1.1.0",
    "npm-check-updates": "^22.2.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-mock-dev-server": "^2.3.0",
    "vite-plugin-pages": "^0.33.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node scripts/verify-commit.js \"$1\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --cache"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write --cache"
    ]
  }
}
